PORT=5000
# Comma-separated list of allowed client origins (omit to allow all in dev)
CLIENT_ORIGIN=http://localhost:5173

# LLM providers — multiple keys per provider allowed, comma-separated (round-robin)
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=

# Malayalam text-to-speech (Sarvam AI)
SARVAM_API_KEY=

# Models. Checked against each provider's model list at startup; the log shows
# what was chosen. If a model is gone you'll see which variable to change here.
GEMINI_MODEL=gemini-3.8-flash
# Tried when GEMINI_MODEL is overloaded. Empty = auto-pick another current flash / flash-lite model
GEMINI_FALLBACK_MODEL=
# Backoff (ms) before retrying Gemini on 503 "high demand" / 429
GEMINI_RETRY_DELAYS_MS=2000,5000
GROQ_MODEL=llama-3.3-70b-versatile
# Empty = use a current Groq vision model if there is one (else Groq is skipped for reports)
GROQ_VISION_MODEL=
# Empty = auto-pick free models (zero prompt + completion price). Paid models are never used.
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=

# Per-call AI timeouts (ms): report reading / vision, and everything else (chat)
LLM_VISION_TIMEOUT_MS=60000
LLM_TIMEOUT_MS=15000

# true = a report file analysed before is always answered from the cache (instant, no AI call),
# even after prompt changes. Turn on for the demo after analysing the demo report once.
DEMO_MODE=false

# Where the last successful report analysis per file is cached (fallback when all providers fail)
# REPORT_CACHE_FILE=./cache/report-analysis.json
