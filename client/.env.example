# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local development without a Firebase project: run the emulators from the repo root
# (`npx firebase emulators:start` from firestore-tests/) and set this to true
# VITE_FIREBASE_EMULATOR=true

# A login lasts for the browser tab only (safe on a shared laptop). true = stay logged in on this device
# VITE_FIREBASE_REMEMBER_LOGIN=true
